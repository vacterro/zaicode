{
  "schema_version": 1,
  "description": "Single declarative host adapter registry (SRC-028:R008). Every consumer -- tools/saipen_engine/admission.py, bootstrap/inject.ps1, bootstrap/inject.sh, tools/autoinject.py, status/freshness reporting and the parity tests -- reads host identity, install surfaces and enforcement capability from THIS file. No consumer may keep a second handwritten host inventory. declared_strength is what the adapter CLAIMS for an installed, current, healthy install; effective enforcement is computed at runtime by admission.effective_strength and is never stronger than the installed state proves.",
  "activation_template": "saipen/ACTIVATION_BLOCK.md",
  "adapters": [
    {
      "id": "opencode",
      "name": "OpenCode",
      "instruction_surfaces": [
        "~/.config/opencode/AGENTS.md"
      ],
      "skill_surfaces": [
        "~/.config/opencode/skills/saipen"
      ],
      "blocking_capability": true,
      "hook_install_surface": "~/.config/opencode/plugins/saipen-guard.js",
      "hook_artifact": "extensions/adapters/opencode/saipen-guard.js",
      "legacy_hook_surfaces": [
        "~/.config/opencode/plugin/saipen-guard.js"
      ],
      "hook_surface_note": "The supported runtime's global local plugin directory is the PLURAL `plugins/` (OpenCode 1.18.x `opencode debug config` reports a plugin origin for it and instantiates the factory). The singular `plugin/` directory is ALSO discovered by the same runtime, so a stale copy there would load this hook a second time: the injectors remove the legacy surface on install and uninstall removes both.",
      "launch_command": "python ~/.config/opencode/skills/saipen/tools/saipen.py --agent <seat> launch opencode -- [arguments]",
      "launch_requirement": "optional_explicit_actor",
      "routine_launch": "generic OpenCode launch; no SAIPEN seat required",
      "launch_implementation": "tools/saipen_engine/host_launch.py",
      "freshness_surfaces": [
        "skill",
        "instruction",
        "hook"
      ],
      "declared_strength": "BLOCKING",
      "artifact_version": 1,
      "install": {
        "home": "~/.config/opencode",
        "skill": "~/.config/opencode/skills/saipen",
        "instruction": "~/.config/opencode/AGENTS.md",
        "hook": "~/.config/opencode/plugins/saipen-guard.js"
      },
      "prelaunch_command": "saipen runtime --prelaunch --adapter opencode --json",
      "prelaunch_contract": "ok+RUNTIME_CURRENT|RUNTIME_RESYNCED admits a host start; every other code refuses it. The supported launch invokes this before the host process exists (saipen/RUNTIME.md)."
    },

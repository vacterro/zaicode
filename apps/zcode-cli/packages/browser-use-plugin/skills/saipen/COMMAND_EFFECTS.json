  "help_tokens": [
    "help",
    "--help",
    "-h"
  ],
  "ingress_payload_verbs": [
    "start",
    "user-request"
  ],
  "not_shell_canonical": [
    "init",
    "clean",
    "translate",
    "first-publish-confirm",
    "launch"
  ],
  "verbs": {
    "help": "DIAGNOSTIC",
    "status": "DIAGNOSTIC",
    "next": "DIAGNOSTIC",

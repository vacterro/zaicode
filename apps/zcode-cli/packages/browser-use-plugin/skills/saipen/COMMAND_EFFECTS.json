{
  "kind": "saipen-command-effects",
  "schema_version": 1,
  "rule_id": "CMD-EFFECT-01",
  "owner": "tools/saipen_engine/command_effects.py",
  "classes": [
    "DIAGNOSTIC",
    "INGRESS",
    "RECOVERY",
    "EXECUTION"

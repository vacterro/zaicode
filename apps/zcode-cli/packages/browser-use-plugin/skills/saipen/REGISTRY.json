 "continue_fallback": {
  "invariant": "continue may fall through to improve ONLY after recovery, blocked/retryable, queued and required-follow-up routing are exhausted; it resumes an existing active Improve cycle and never creates an unbounded improve carousel",
  "marker": ".saipen/extensions/continue_fallback.json",
  "owner": "tools/saipen_engine/continue_fallback.py",
  "test": "tools/test_continue_improve_fallthrough.py"
 },
 "audit_inbox": {
  "rule_id": "SOURCE-AUDIT-INBOX-01",
  "directory": "audit",
  "filename_regex": "^[1-9][0-9]*\\.md$",
  "recursive": false,
  "source_kind": "external_audit",
  "generation_identity": "relative_path+sha256",
  "ordering": "LOWEST_WORKABLE_LAYER",
  "continue_position": "AFTER_ACTIVE_BEFORE_BOARD_PICK",
  "delete_gate": "SOURCE_CLOSED_AND_CURRENT_HASH_MATCHES",
  "delete_operation": "audit_inbox.consume",
  "renumber_after_delete": false,
  "residue_policy": "REPORT_NEVER_DELETE",
  "residue_exempt_prefix": ".",
  "clean_verdict": "NO_LAYER_AND_NO_RESIDUE",
  "binding": ".saipen/intake/audit_inbox.json",
  "migration_binding": "legacy_transport_equivalent",
  "generation_states": [
   "NEW",
   "ACTIVE",
   "BLOCKED",
   "CLOSED_PENDING_DELETE",
   "DELETED",
   "INVALID",
   "MISSING_AFTER_CAPTURE"
  ],
  "owner": "tools/saipen_engine/audit_inbox.py",
  "test": "tools/test_audit_inbox.py"
 },
 "hush_precedence": {
  "order": [
   "user",
   "safety",
   "core",
   "execution_policy",
   "style"
  ],
  "owner": "saipen/EXECUTION.md",
  "status": "active",
  "runtime": "tools/saipen_engine/hush.py",
  "test": "tools/test_hush_runtime.py",
  "modifier": "hush",
  "scope": "TASK_LOCAL_NEVER_PERSISTED",
  "suppressible": [
   "preamble",
   "progress",
   "plan",
   "tool_narration",
   "success_chatter",
   "details"
  ],
  "mandatory": [
   "safety_refusal",
   "destructive_confirmation",
   "missing_authority",
   "terminal_failure",
   "protocol_corruption",
   "side_effect_acknowledgement",
   "final_report",
   "evidence"
  ],
  "final_report_max_lines": 20
 },
 "audit_enqueue": {
  "rule_id": "SOURCE-AUDIT-ENQUEUE-01",
  "allocator": ".saipen/intake/audit_allocator.json",
  "lock": ".saipen/locks/audit-allocator.lock",
  "allocation": "MONOTONIC_NEVER_REUSED",
  "placement": "TEMP_THEN_ATOMIC_RENAME",
  "idempotency_key": "producer+producer_operation_id",
  "operation_states": [
   "RESERVED",
   "COMMITTED"
  ],
  "producer_writes": [
   "audit/<N>.md",
   ".saipen/intake/audit_allocator.json"
  ],
  "producer_claims": "UNTRUSTED",
  "envelope_open": "<!-- saipen-audit-envelope",
  "envelope_optional": true,
  "maintainer_verdict_on_intake": "PENDING",
  "owner": "tools/saipen_engine/audit_enqueue.py",
  "envelope_owner": "tools/saipen_engine/audit_envelope.py",
  "test": "tools/test_audit_enqueue.py",
  "envelope_test": "tools/test_audit_envelope.py"
 }
}

{
  "clauses": {
    "SRC-151:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435\u0442 \u0444\u043e\u043b\u0431\u0435\u043a\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e ![](media/001_clipboard_20261005_021327_245012af.png)"
    },
    "SRC-151:R002": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c composer \u043d\u0435 \u0432\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043d\u0443\u0436\u043d\u044b\u0435 \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0443\u0441\u0442\u044c \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u0443\u0434\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e ![](media/002_clipboard_20261005_001158_916a165b.png)"
    },
    "SRC-151:R003": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0411\u044b\u0432\u0430\u0435\u0442 \u0435\u0449\u0435 ProTrail \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0441\u0430\u043c\u044b\u0439 \u0437\u0430\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0437\u0430 \u0432\u0441\u0435\u043c\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c\u0438 \u0431\u0443\u0434\u0442\u043e \u0438 \u043b\u0435\u0447\u0438\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c."
    },
    "SRC-151:R004": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0442\u0430\u043a\u043e\u0439 \u0431\u0430\u0433 \u043a\u043e\u0433\u0434\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u044e \u043e\u043a\u043d\u043e \u0430 \u043e\u043d\u043e \u0432\u043e\u0442 \u0442\u0430\u043a \u043c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f ![](media/003_clipboard_20261004_201704_126aea3e.png) ![](media/004_clipboard_20261004_201606_bcb06d39.png) ![](media/005_clipboard_20261004_233630_193397e8.png)"
    },
    "SRC-151:R005": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0432\u0441\u0451 \u0435\u0449\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0447\u0442\u043e \"\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\" \u043d\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0443\u0436\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443 ![](media/006_clipboard_20261004_184012_f4829648.png)"
    },
    "SRC-151:R006": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c \u043a\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e goal cc all \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e \u044d\u0442\u043e ![](media/007_clipboard_20261004_181959_a300c5bb.png) \u0432 queued \u0441\u0442\u0440\u043e\u043a\u0435 \u043f\u0438\u0448\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e goal cc all \u0433\u0434\u0435 \u043d\u0435\u0442 \u0434\u0430\u0436\u0435 ![](media/008_clipboard_20261004_182041_197b0fe1.png) \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0447\u0442\u043e \u0442\u0430\u043c \u0444\u0430\u0439\u043b \u0432\u043b\u043e\u0436\u0435\u043d - \u044d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c"
    },
    "SRC-151:R007": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 ZAICODE \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u043d\u043e\u0432\u043e\u0433\u043e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 real time \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0451 \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u043e\u0441\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0438 \u043d\u0430\u0434\u0451\u0436\u043d\u043e. \u042f \u0432\u043e\u0442 \u0437\u0430\u0448\u0451\u043b \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u0443\u0433\u043b \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u0432 SAITULS Accounts, \u0430 ZAICODE \u0435\u0449\u0435 \u0432\u0438\u0434\u0438\u043c\u043e \u0441\u0442\u0430\u0440\u0443\u044e \u0438\u043c\u0435\u0435\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0447\u0442\u043e \u043f\u0443\u0442\u0430\u0435\u0442. ![](media/009_clipboard_20261004_181625_42c3f7c2.png) - \u0434\u0430\u0436\u0435 \u043d\u0435\u0442 \u0437\u0430\u0439\u0442\u0438\u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u043e\u0432 \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0435\u043d\u0434\u043e\u0440\u0430 \u0442\u043e\u043a\u0430 Codex \u0438 Claude \u0432\u0438\u0436\u0443 \u0438 \u0432\u0441\u0451, \u043d\u0443\u0436\u043d\u043e \u0432 \u043e\u0431\u0449\u0435\u043c \u044d\u0442\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e."
    },
    "SRC-151:R008": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 ZAICODE \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c A3 audit wave \u0432\u043e\u043e\u0431\u0449\u0435 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u043c\u044b\u043c toggleable \u0447\u0442\u043e\u0431\u044b \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b auto conitnue/continue all \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438 \u044d\u0442\u043e \u0434\u043e\u043b\u0436\u043d \u0431\u044b\u0442\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u0442\u043e\u0435\u0441\u0442\u044c \u0441\u043a\u0430\u0436\u0435\u043c \u0432\u043a\u043b\u0430\u0434\u043a\u0430 Audit \u0432 ZAICODE \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0430\u044f enabled disabled."
    }
  },

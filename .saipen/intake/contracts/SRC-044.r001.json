{
  "clauses": {
    "SRC-044:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u041f\u0440\u0438\u0432\u0435\u0442, \u041e\u043f\u0443\u0441. \u0412\u043e\u0442, \u0434\u0435\u0440\u0436\u0438 \u0435\u0449\u0435 \u043d\u0430 \u043a\u0430\u0440\u0430\u043d\u0434\u0430\u0448:  --- \u2022 \u041c\u0435\u0436\u0434\u0443 \u043a\u0440\u0430\u0448\u0430\u043c\u0438 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0441\u0442\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f, \u0433\u0434\u0435 \u0435\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u0435 \u0442\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e\u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c.  \u2022 \u041f\u0443\u0441\u0442\u044c \u0432 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u0442\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043f\u0440\u044f\u043c \u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0431\u0443\u043a\u0432\u0430\u043c\u0438. ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_162425_f532b932.png) \u0430 \u0442\u043e \u0442\u0443\u0442 \u0442\u043e\u043a\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u0441\u0435\u0441\u0441\u0438\u0438. \u0422\u0430\u043a\u0436\u0435 \u044d\u0442\u043e \u0442\u043e\u0436\u0435 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445, justify, \u0448\u0440\u0438\u0444\u0442, \u0440\u0430\u0437\u043c\u0435\u0440 etc etc etc \u0442\u0430\u043a\u0436\u0435.  \u2022 \"DONE\" \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438 \u0441\u0443\u0432\u0430\u0442\u044c \u043e\u0431\u0440\u044b\u0432\u043e\u0447\u043d\u044b\u0435 \u0441\u0435\u0441\u0441\u0438\u0438. \u0422\u043e\u0433\u0434\u0430 \u043f\u0443\u0441\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u043e INTERRUPTED \u0438\u043b\u0438 \u043a\u0430\u043a \u0442\u043e \u0442\u0430\u043a \u0442\u043e\u0436\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435 \u043f\u043e \u0441\u043c\u044b\u0441\u043b\u0443.  \u2022 \u0422\u0430\u043a \u0447\u0442\u043e \"\u041f\u043b\u044d\u0439\" \u043d\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043d\u043e\u0432\u0443\u044e \u0441\u0435\u0441\u0441\u0438\u044e, \u0430 \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u043e\u0431\u0440\u044b\u0432\u043e\u0447\u043d\u0443\u044e \u0442\u0435\u043a\u0443\u0449\u0443\u044e. ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_162008_0b070991.png) \u043f\u043e \u0443\u043c\u043d\u043e\u043c\u0443 \u0432 \u043e\u0431\u0449\u0435\u043c.  \u2022 \u0429\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b \u0433\u0434\u0435 \u0442\u043e 8 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0437\u0430\u0434\u0430\u0447, \u0432\u044b\u043b\u0435\u0442\u0435\u043b\u043e.  \u2022 \u0415\u0449\u0435 \u043d\u0443\u0436\u0435\u043d \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e 3 \u0440\u0435\u0436\u0438\u043c \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f, \u0433\u0434\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u043e\u0435\u043a\u0442 - \u0441\u0430\u043c MAIN \u0441\u043b\u043e\u0442 \u0442\u0438\u043f\u043e, \u043e\u043d \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0438 \u0438\u043c\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0442\u043e \u0436\u0435, \u0430 \u0441\u0443\u0431\u0441\u0430\u0439\u043f\u0435\u043d\u044b \u0443\u0436\u0435 \u043a\u0430\u043a child \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043c\u043e\u0436\u043d\u043e \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0435\u0449\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 \u0442\u0438\u043f\u043e CLEAR ALL DONE \u0442\u0430\u043c \u0433\u0434\u0435 \u0435\u0441\u0442\u044c next exact action - \u0432\u043e\u0442 \u0442\u0435 \u043e\u0447\u0438\u0449\u0430\u0442\u044c \u0447\u0430\u0442\u044b, \u0430 \u0433\u0434\u0435 \u043e\u0431\u0440\u044b\u0432 -> cc (\u044d\u0442\u043e \u0434\u043b\u044f continue). \u0412 \u043e\u0431\u0449\u0435\u043c \u0432\u043e\u0442 \u0442\u0430\u043a \u0433\u0430\u0440\u043c\u043e\u043d\u0438\u0447\u043d\u043e, \u043b\u043e\u0433\u0438\u0447\u043d\u043e, \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e \u0441\u043c\u044b\u0441\u043b\u0443.  \u2022 \u0417\u0434\u0435\u0441\u044c \u0432\u0438\u0434\u0438\u043c\u043e \u0438\u043a\u043e\u043d\u043a\u0430 \u0432\u043e\u0440\u043a\u0435\u0440\u0430 \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_161143_29205a15.png)  \u2022 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_160823_df75a4c6.png) \u0412\u0440\u043e\u0434\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b \u0432 \"queue\" \u043d\u043e \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0432\u0438\u0434\u0438\u043c\u043e.  \u2022 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_130709_53d42e44.png) \u0410\u0433\u0435\u043d\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0442\u043e goal cc all \u043d\u0430\u043f\u0438\u0441\u0430\u043b \u0434\u0430\u0436\u0435 \u0442\u0443\u0434\u0430 \u0433\u0434\u0435 \u0443\u0436\u0435 \u0435\u0441\u0442\u044c \u0441\u043b\u043e\u0442 \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439 main. \u042d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c, \u043d\u0438\u043a\u0443\u0434\u0430 \u043f\u043e\u043f\u0430\u043b\u043e, \u0430 \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0441 \u0441\u0430\u043c\u044b\u0445 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u043d\u044b\u0445 \u0440\u0435\u043f\u043e, \u0433\u0434\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u0442\u0443\u0434\u0443\u0448\u0435\u043a, \u0431\u043b\u043e\u043a\u0435\u0440\u043e\u0432, \u0441\u0440\u0430\u043d\u0438 \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435, \u0443\u043c\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0432 \u043e\u0431\u0449\u0435\u043c.  \u2022 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_155704_d8a03aa2.png) \u043f\u0443\u0441\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u043e\u0432\u044b\u0432\u0430\u0442\u044c.  \u2022 SCHEDULER SAIAGENT \u0442\u043e\u0433\u043b \u0433\u0434\u0435 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0442\u044c\u044c \u0442\u043e\u043a\u0430 \u0432 \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u043d\u044b\u0445 \u0441\u0435\u0441\u0441\u0438\u044f\u0445 \u043a\u0430\u043a \u0444\u0443\u043d\u043a\u0446\u0438\u044f. /goal \u0414\u0430"
    }
  },

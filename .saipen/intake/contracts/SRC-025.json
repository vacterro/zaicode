\u0441\u0442\u043e \u043d\u0430 UI \u043a\u0443\u0434\u0430 \u043d\u0438\u0431\u0443\u0434\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e.. ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_123518_384db579.png)\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u044d\u0442\u043e\u0442 \u0431\u043b\u043e\u043a \u0441 New task, search etc etc \u0431\u0443\u0434\u0435\u0442 \u0441\u043a\u0440\u044b\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e, ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_123409_06e9231a.png)\n \u0436\u0451\u043b\u0442\u044b\u043c \u043e\u0442\u043c\u0435\u0447\u0435\u043d\u043e \u0433\u0434\u0435 \u0441\u043a\u0440\u044b\u0432\u0430\u043b\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c toggleable. \u041c\u0435\u043d\u044c\u0448\u0435 \u0448\u0443\u043c\u0430 \u0434\u043b\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e.\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0436\u0438\u043c \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u043c\u044b\u0439 \u0433\u0434\u0435 \u043d\u0430\u0432\u0435\u0440\u0445 \u0441\u0430\u043c\u044b\u0439 \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u044f\u0442 \u0442\u0435 \u0447\u0442\u043e \u0449\u0430\u0441 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u0432 sidebar \u0442\u0438\u043f\u043e \u0441\u0432\u0435\u0436\u0438\u0435 \u0441\u0432\u0435\u0440\u0445\u0443 \u0441\u0442\u0430\u043a\u0430\u044e\u0442\u0441\u044f \u043f\u043e \u0433\u043e\u0442\u043e\u0432\u043d\u043e\u0441\u0442\u0438.\n\n\u2022 \u0421\u0434\u0435\u043b\u0430\u0439 \u0432 SIDEBAR \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u043a\u0430\u043a \u0432 AUDAPACK \u043f\u043e \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f\u043c \u0442\u0438\u043f\u043e MAIN0 MAIN1 SIDE0 SIDE1 SIDE2 etc \u0442\u0438\u043f\u043e \u043a\u0430\u043a \u043f\u0440\u0438\u043e\u0440\u0438\u0442\u0435\u0442\u044b \u043f\u043e \u0441\u043b\u043e\u0442\u0430\u043c \u0438 \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043b\u0435\u0433\u043a\u043e, \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e. \u0421\u0434\u0435\u043b\u0430\u0439 \u0442\u0430\u043c \u043f\u043e\u043a\u043e\u043c\u043f\u043a\u0430\u043a\u0442\u043d\u0435\u0435 \u0432\u0441\u0451 \u0438 \u0443\u0431\u0435\u0440\u0438 \u043f\u0443\u0441\u0442\u044b\u0435 \u043c\u0435\u0441\u0442\u0430 \u043f\u043e \u0432\u044b\u0441\u043e\u0442\u0435 \u0447\u0442\u043e\u0431\u044b \u0432\u043c\u0435\u0449\u0430\u043b\u043e\u0441\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u0441\u0451. \u041c\u0435\u043d\u044c\u0448\u0435 \u043f\u0443\u0437\u044b\u0440\u0438\u0441\u0442\u043e\u0441\u0442\u0438 \u0438 \u0432\u0441\u044f\u043a\u0438\u0445 \u0430\u043d\u0438\u043c\u0430\u0448\u0435\u043a, \u0432\u0441\u043b\u044b\u0432\u0430\u0448\u0435\u043a \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435. \u042d\u0442\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u043c\u043e, default on.\n\n\u2022 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_092920_786b26ef.png) - \u043f\u0443\u0441\u0442\u044c \u0431\u0443\u0434\u0435\u0442 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u044f\u0435\u043c\u043e \u044d\u0442\u043e \u043e\u043a\u043e\u0448\u043a\u043e \u0441 todo. \u041d\u0430\u0436\u0430\u0442\u0438 \u043d\u0430 todolist \u0434\u043e\u043b\u0436\u043d\u043e \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043e\u0431\u0440\u0430\u0442\u043d\u043e.\n\n\u2022 \u041d\u0443\u0436\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u0447\u0438\u043d\u0438\u0442\u044c \u0438\u043a\u043e\u043d\u043a\u0438 \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u0431\u044b\u043b\u0438 \u0447\u0438\u0442\u0430\u0435\u043c\u044b\u0435 \u0442\u043e\u0436\u0435.![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_132252_c99dc4fb.png)\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u0431\u0443\u0434\u0435\u0442 \u043a\u043d\u043e\u043f\u043a\u0430 clear \u0440\u044f\u0434\u043e\u043c \u0441 \u0441\u0442\u0430\u0440\u0442 \u0433\u0434\u0435 \u044f \u043c\u043e\u0433\u0443 \u0438\u0437 \u044d\u0442\u043e\u0439 \u0441\u0435\u0441\u0441\u0438\u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u0440\u0430\u0437\u0443 \u043d\u0430\u0447\u0430\u0442\u044c \u0437\u0430\u043d\u043e\u0432\u043e. ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_102850_57b2c396.png) \u0442\u0438\u043f\u043e \u043a\u0430\u043a /new /clear \n\n\u2022 \u041a\u043e\u0433\u0434\u0430 \u0445\u0438\u0442 \u043b\u0438\u043c\u0438\u0442\u043e\u0432 \u043f\u0435\u0440\u0432\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435, \u0442\u0438\u043f\u043e \u0433\u043b\u043c \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u0432 \u043b\u0438\u043c\u0438\u0442\u0435, undo \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0438 \u0435\u0433\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0430 \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u0441\u043d\u043e\u0432\u0430 \u0434\u0435\u043b\u0430\u0435\u0442 \u0432\u0438\u0434 \u0431\u0443\u0434\u0442\u043e \u044f \u043f\u044b\u0442\u0430\u044e\u0441\u044c glm \u043c\u043e\u0434\u0435\u043b\u044c\u044e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f, \u043d\u043e \u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b saifren \u043f\u0435\u0440\u0435\u0434 \u044d\u0442\u0438\u043c \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e.\n\n\u2022 \u042f \u0431\u044b \u0445\u043e\u0442\u0435\u043b \u0443\u0431\u0440\u0430\u0442\u044c \u044d\u0442\u0438 suggesting prompts \u0441 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u044d\u043a\u0440\u0430\u043d\u0430 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_092200_81311e00.png)\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u0435\u0441\u043b\u0438 \u043f\u0443\u0441\u0442\u043e \u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u0433\u0440\u0443\u0441\u0442\u043d\u043e\u0435 \"Empty\" \u0442\u0430\u043a\u043e\u0435 \u0432\u043e\u0442 \u0437\u0430\u0442\u0438\u043d\u0442\u0435\u043d\u0443\u0442\u0442\u043e\u0435, tinted.![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260924_090211_9a05ca2c.png)\n\n---\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0430 /goal \u0431\u0443\u0434\u0435\u0442 \u0437\u043d\u0430\u0447\u0438\u0442 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0430 \u0435\u0441\u043b\u0438 SAIPEN \u0442\u043e\u0433\u0434\u0430 \u0432\u0441\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u0442\u0438\u043a\u0435\u0442\u044b \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e \u0431\u0435\u0437 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430.\n\n\u2022 \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435\u043f\u043e\u043d\u044f\u0442\u043d\u043e \u0435\u0449\u0435 \u043a\u0430\u043a ZAICODE \u044d\u0442\u0438 \u0430\u0433\u0435\u043d\u0442\u044b \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u0441\u044f. \u042f \u0431\u044b \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0442\u0435\u043b \u0435\u0449\u0435 \u0440\u0435\u0436\u0438\u043c\u044b \u043f\u0440\u043e\u0441\u0442\u043e Hunter/Tester/Cleaner/Wikier/Translator \u043a\u0430\u043a \u0441\u0443\u0431\u0441\u0430\u0439\u043f\u0435\u043d\u044b \u0432\u0441\u0451 \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u044e\u0442 \u0434\u043e \u0431\u043b\u0435\u0441\u043a\u0430. [2026-09-24_112528.png](file:///V:/___VAC/_PIC/_PRNTSCREEN/2026-09-24_112528.png)[2026-09-24_112516.png](file:///V:/___VAC/_PIC/_PRNTSCREEN/2026-09-24_112516.png)\n\n---"

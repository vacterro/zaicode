    "SRC-139:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0412\u043e\u0442 \u0437\u0434\u0435\u0441\u044c \u0432 usage \u043f\u0430\u043d\u0435\u043b\u0435 \u043c\u0435\u0442\u0440\u0435 live \u0441\u0434\u0435\u043b\u0430\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435 \u0442\u043e\u043a\u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433 10 \u0441\u0435\u043a, \u043d\u043e \u0438 5, 3, 2, 1 \u0441\u0435\u043a; \u0423\u0431\u0435\u0440\u0438 \"Done\" \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u0441\u043b\u043e\u0432\u043e - \u043e\u043d\u043e \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0435\u0441\u043b\u0438 99,99% \u0432\u0441\u0435\u0433\u0434\u0430 \"done\", \u0434\u043e\u0431\u0430\u0432\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c-\u0438\u0437\u043c\u0435\u043d\u044f\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u0448\u0438\u0440\u0438\u043d\u044b \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0447\u0442\u043e\u0431\u044b \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0438\u043b\u0438\u0438 \u0434\u0440\u0443\u0433\u043e\u0435 \u0442\u0430\u043c \u0432\u043c\u0435\u0449\u0430\u043b\u043e\u0441\u044c \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435."
    }

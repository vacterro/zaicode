{
  "clauses": {
    "SRC-097:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0425\u043e\u0440\u043e\u0448\u043e, \u043f\u0443\u0441\u0442\u044c \u0443 \u044e\u0437\u0435\u0440\u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0430\u0434 \u043a\u0430\u0436\u0434\u044b\u043c \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u043c, \u0438\u043a\u043e\u043d\u043a\u043e\u0439, \u0437\u0432\u0443\u043a\u043e\u043c (\u0442\u0430\u043c \u0433\u0434\u0435 \u0435\u0449\u0435 \u044d\u0442\u043e\u0433\u043e \u043d\u0435\u0442), \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435\u043c \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432, \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u0438 \u0442\u0430\u043a\u0436\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044c \u0447\u0442\u043e FREE \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0438\u0445 \u043d\u0435 \u0437\u0430\u043d\u0438\u043c\u0430\u0435\u0442 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0441\u043b\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0432 \u043f\u0435\u0440\u0432\u0443\u044e \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0443, \u043f\u0443\u0441\u0442\u044c ZAICODE + SAIPEN + SAIMAIL \u0431\u0443\u0434\u0443\u0442 \u0435\u0434\u0438\u043d\u044b\u043c \u0446\u0435\u043b\u044b\u043c \u0442\u0430\u043a \u0447\u0442\u043e \u044f \u043c\u043e\u0433\u0443 \u043f\u043e\u0442\u043e\u043c \u0435\u0441\u043b\u0438 \u0447\u0442\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0442\u044c \u0438\u0445 \u043f\u043e \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u0435\u0441\u043b\u0438 \u0447\u0442\u043e \u0438 \u044d\u0442\u043e \u0432\u0441\u0451 \u043f\u043e\u0434\u0442\u044f\u0433\u0438\u0432\u0430\u043b\u043e\u0441\u044c \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438, \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a \u0442\u043e\u0433\u0434\u0430 \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0439 \u0432 1 \u043a\u043b\u0438\u043a, \u0443\u0431\u0435\u0438\u0441\u044c \u0447\u0442\u043e \u043e\u043d \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0438 \u0442\u043e\u0433\u0434\u0430 \u0432\u0441\u0451 \u0437\u0430\u043f\u0443\u0448 \u0438 \u0437\u0430\u043a\u043e\u043c\u043c\u0438\u0442\u044c \u0432 \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u0432\u0435\u0442\u043a\u0443 \u043a\u0440\u0430\u0441\u0438\u0432\u043e, \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u041e\u043f\u0443\u0441 :)"
    }
  },

  "clauses": {
    "SRC-100:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0418\u043d\u043e\u0433\u0434\u0430 \u043c\u043e\u0436\u0435\u0442 \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0447\u0442\u043e \u043f\u0440\u043e\u0435\u043a\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043f\u043e\u043a\u0430 \u043d\u0430 \u043d\u0435\u0433\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u0439\u0434\u0451\u0448\u044c.\n\n\u2022 \u0418 \u0442\u043e\u0433\u0434\u0430 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0451 \u0432 \u0441\u0442\u043e\u0440\u043e\u043d\u0443 \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u043b\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u043e\u043f\u0442\u0438\u043c\u0438\u0437\u0430\u0446\u0438\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u0438 \u0432 \u0446\u0435\u043b\u043e\u043c \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e \u043f\u043e \u0446\u0435\u043d\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0443 \u043f\u043e\u0434 \u043a\u0430\u043f\u043e\u0442\u043e\u043c \u0441\u0440\u0430\u0437\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u043e.\n\n\u2022 \u041d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432 ZAICODE \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u0435\u0441\u043b\u0438 \u0434\u0435\u0442\u0435\u043a\u0442\u0438\u043a \u0442\u0438\u043f\u043e 5h limit starts at first use \u0442\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043a\u0443\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u044d\u0442\u043e\u0442 \u043e\u0442\u0447\u0451\u0442 \u043d\u0430\u0447\u0430\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0440\u0430\u0437\u0443 \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u0438 5 \u0447\u0430\u0441\u043e\u0432 \u0432\u0435\u0447\u043d\u043e \u043a\u0440\u0443\u0442\u0438\u043b\u0438\u0441\u044c, \u0430 \u043d\u0435 \u0436\u0434\u0430\u043b\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u0430\u043a \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u043b\u0438\u043c\u0438\u0442\u044b \u043d\u0435 \u0442\u0440\u0430\u0442\u0438\u043b\u0438\u0441\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c \u0442\u0430\u043c \u043d\u0443 10 \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c...\n\n\u2022 \u041d\u0443\u0436\u043d\u043e \u0443\u0431\u0440\u0430\u0442\u044c \u0432\u043e\u043e\u0431\u0449\u0435 \u044d\u0442\u0438 approvals - ZAICODE \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c FULL ACCESS YOLO MODE ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260930_135944_61f2fd8e.png)\n\n\u0418 \u0447\u0442\u043e \u0437\u0430 \"\nTask output\nexec_56aae3c0-bca0-43f2-bdbd-4533d5509a9f\nWait timed out\nFetching output\nexec_56aae3c0-bca0-43f2-bdbd-4533d5509a9f\n\" \u0442\u0430\u043a\u043e\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u0435\u0442 \u0434\u043e 15 \u043c\u0438\u043d\u0443\u0442 \u0432\u0438\u0441\u0435\u0442\u044c.\n\n\u0414\u0430\u0432\u0430\u0439 \u0442\u043e\u0433\u0434\u0430 \u0434\u043e \u043a\u043e\u043d\u0446\u0430, \u0431\u0438\u043b\u0434\u0438 \u0442\u043e\u0433\u0434\u0430 \u0431\u0438\u043b\u0434 \u043c\u0435\u0436\u0434\u0443 \u0437\u043d\u0430\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u043c\u0438 \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u0430 \u043d\u0435 \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044f\u0441\u044c."
    }

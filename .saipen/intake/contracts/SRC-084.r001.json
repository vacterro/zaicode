{
  "clauses": {
    "SRC-084:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0425\u043e\u0440\u043e\u0448\u043e. \u041f\u043e\u043a\u0430 \u0436\u0434\u0451\u0448\u044c, \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430 SAIMAIL \u0438 \u0435\u0433\u043e \u0442\u043e\u0436\u0435 \u043f\u043e\u0434\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u0439. \u0412\u0441\u043a\u0440\u043e\u0439 \u043a\u043e\u043d\u0432\u0435\u0440\u0442\u044b (\u0442\u0430\u043c \u0438\u0445 2 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c; v:\\___VAC\\__K\\__CODE\\_AI_STUFF_AGENTIC\\__SAIMAIL__\\) \u0438 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u0447\u0442\u043e\u0431\u044b \u0430\u0433\u0435\u043d\u0442\u044b \u043d\u0435 \u043f\u0440\u0438\u0441\u044b\u043b\u0430\u043b\u0438 \u0442\u043e, \u0447\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u0438\u0441\u043b\u0430\u0442\u044c \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u043c \u0447\u0430\u0442\u0435. SAIMAIL \u0437\u0430\u0434\u0443\u043c\u044b\u0432\u0430\u043b\u0441\u044f \u043a\u0430\u043a \u043e\u0441\u043e\u0431\u043e\u0435 \u043f\u043e\u0447\u0442\u043e\u0432\u043e\u0435 \u043e\u0442\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043a\u043e\u0433\u0434\u0430 \u0442\u0430\u043c \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0447\u0442\u043e\u0442\u043e \u0432\u0430\u0436\u043d\u043e\u0435, \u0430 \u043d\u0435 \u043f\u043e \u0440\u0430\u0431\u043e\u0442\u0435. \u0410 \u0435\u0441\u043b\u0438 \u0438 \u043f\u043e \u0440\u0430\u0431\u043e\u0442\u0435 \u0442\u043e \u044d\u0442\u043e \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u043f\u0440\u044f\u043c \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0440\u0435\u0448\u0430\u044e\u0449\u0435\u0435 \u0430 \u043d\u0435 \u0434\u0443\u0431\u043b\u0438\u043a\u0430\u0442 \u0442\u043e\u0433\u043e \u0447\u0442\u043e \u0443\u0436\u0435 \u0430\u0433\u0435\u043d\u0442 \u043e\u0442\u0432\u0435\u0442\u0438\u043b \u0432 \u0447\u0430\u0442\u0435. \u041f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u0438 \u0440\u0435\u0448\u0438 \u0441\u0442\u043e\u0438\u0442 \u043b\u0438 \u044d\u0442\u0438 \u043f\u0438\u0441\u044c\u043c\u0430 \u0442\u043e\u0433\u043e \u0447\u0442\u043e\u0431\u044b \u0431\u044b\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u043c\u0438, \u0435\u0441\u043b\u0438 \u0442\u0430\u043a \u0442\u043e \u043e\u0441\u0442\u0430\u0432\u044c, \u0430 \u0435\u0441\u043b\u0438 \u043d\u0435\u0442 \u0442\u043e \u043f\u043e\u0434\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u0443\u0439 SAIMAIL \u0442\u043e\u0436\u0435."
    }

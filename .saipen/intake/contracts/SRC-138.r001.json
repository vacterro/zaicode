{
  "clauses": {
    "SRC-138:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0422\u0430\u043a\u0436\u0435 \u0434\u043e\u0431\u0430\u0432\u044c \u0432 \u043a\u043e\u043c\u043f\u043e\u0437\u0435\u0440 \u043a\u043d\u043e\u043f\u043a\u0443 \u043a\u0430\u043a Auto-Goal \u0440\u0435\u0436\u0438\u043c: \u041e\u043d\u043e \u0437\u0430\u0434\u0430\u0451\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443 \u0441 \u043b\u044e\u0431\u044b\u043c \u043f\u0440\u043e\u043c\u043f\u0442\u043e\u043c \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u043a\u0440\u044b\u0442\u043d\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u044e\u0437\u0435\u0440 \u0432\u0435\u0437\u0434\u0435 \u0432 \u043a\u043e\u043d\u0446\u0435 \u043f\u0438\u0448\u0435\u0442 \"goal cc all\" \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f. \u0422\u0430\u043a\u0436\u0435 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0435\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0434\u0441\u0432\u0435\u0447\u0435\u043d\u043e, \u0430 \u0435\u0441\u043b\u0438 \u043d\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043d\u0435\u0442, \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0422\u043e\u0435\u0441\u0442\u044c \u0441\u043c\u044b\u0441\u043b \u0432 \u0442\u043e\u043c \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u0434\u0430\u0451\u0442 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0445\u0435\u043d\u0434\u043e\u0444\u0444 \u0438\u043b\u0438 \u043f\u0440\u043e\u043c\u043f\u0442, \u0432 \u043a\u043e\u043d\u0446\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e \u043d\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0430\u0442\u0441\u044f \u0447\u0442\u043e Goal \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u0440\u043e\u043c\u043f\u0442\u043e\u043c \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u043e, \u044d\u0442\u043e \u0438\u0437\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043b\u0435\u0434\u043e\u043c \u0434\u0430\u0432\u0430\u0442\u044c goal cc all \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u044d\u0442\u043e \u0443\u0434\u043e\u0431\u043d\u043e \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e."
    }
  },

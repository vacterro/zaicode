{
  "clauses": {
    "SRC-038:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443 \u0438 \u043f\u0440\u043e 33 \u044f\u0437\u044b\u043a\u043e\u0432 \u0442\u043e\u0436\u0435 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0442\u044c. \u042d\u0442\u043e \u0437\u0430\u0434\u0430\u0447\u0430 \u0434\u043b\u044f \u043f\u0443\u043b\u0430 SAIFREN \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0434 \u043a\u043e\u043d\u0435\u0446.\n\n\u2022 \u041f\u043e\u044d\u0442\u043e\u043c\u0443 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0442\u043e\u0436\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043b\u0451\u0433\u043a\u043e\u0439, \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u043b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0449\u0438\u043a \u043f\u043e\u0434\u043e\u0436\u0434\u0430\u043b \u0433\u043e\u0442\u043e\u0432\u043e, \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439, \u0432\u043e\u0442 \u044f\u0440\u043b\u044b\u043a \u0436\u0434\u0451\u0442, \u0433\u043e\u0442\u043e\u0432\u043e, \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0439 \u0438 \u043a\u043e\u0434\u0438. \u0412\u0441\u0451 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u043e\u0435, \u0432\u0441\u044f \u043c\u0438\u0448\u0443\u0440\u0430, ZAICODE; SAIPEN; SAIMAIL \u0432\u0441\u0451 \u043f\u043e\u0434\u0442\u044f\u0433\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u043e\u043c, \u0441\u0432\u0435\u0436\u0430\u043a \u0438\u0437 \u0433\u0438\u0442\u0445\u0430\u0431\u0430, \u0432\u0441\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438 \u0442\u0430\u043a \u0432\u0441\u0451 \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0438 \u043d\u0430\u0434\u0451\u0436\u043d\u043e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u043e\u043a\u043e\u0439\u043d\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u044e. \u0412\u0441\u0451 \u043e\u0447\u0435\u043d\u044c \u0445\u043e\u0440\u043e\u0448\u043e \u0432 \u044d\u0442\u043e\u043c \u043f\u043b\u0430\u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c, \u0431\u0435\u0437 \u0431\u0443\u0431\u043d\u043e\u0432. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 -> Autotroubleshoot \u0436\u0435\u043b\u0435\u0437\u043e\u0431\u0435\u0442\u043e\u043d\u043d\u044b\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0440\u0435\u0448\u0430\u0435\u0442 \u0432\u0441\u0435 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b \u0441 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u043e\u0439, \u043f\u043e\u043b\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c, \u0434\u0435\u043f\u043b\u043e\u0435\u043c etc etc etc. \u0412\u043e\u0442 \u044d\u0442\u043e \u0431\u0443\u0434\u0435\u0442 \u043e\u0447\u0435\u043d\u044c \u043a\u0440\u0443\u0442\u043e.\n\n\u2022 \u0412\u043e\u043e\u0431\u0449\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u043f\u0440\u043e\u0435\u043a\u0442 ZAICODE \u044d\u0442\u043e \u0442\u0435\u043f\u0435\u0440\u044c \u043a\u0432\u0438\u043d\u0442\u0435\u044d\u0441\u0441\u0435\u043d\u0446\u0438\u044f ZAICODE + SAIPEN + SAIMAIL. \u0411\u0443\u0434\u0435\u0442 \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043c \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c\u0441\u044f \u043a\u0430\u043a \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u043f\u0440\u043e\u0434\u0443\u043a\u0442 \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043a\u0442\u043e \u0445\u043e\u0447\u0435\u0442 \u043a\u043e\u0434\u0438\u0442\u044c \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u0431\u044b\u0441\u0442\u0440\u043e \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e. \u042d\u0442\u043e \u043e\u0442\u043b\u0438\u0447\u043d\u0430\u044f \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0430 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u043a\u0438 SAIPEN \u0438 \u043a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 SAIMAIL \u0438 \u043a\u0430\u043a ZAICODE \u0432\u0441\u0451 \u044d\u0442\u043e \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u0441\u0442\u0440\u043e\u044e.\n\n\u2022 \u041f\u0443\u0441\u0442\u044c \u0431\u0443\u0434\u0443\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432\u0441\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0445 \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043e\u043a, \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0447\u0430\u0442\u044c \u0441 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 title \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0430 \u0442\u0430\u043c \u0443\u0436\u0435 \u0432\u0441\u0451 \u0441\u043c\u0435\u0436\u043d\u043e\u0435, \u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a, \u0442\u0438\u043f\u043e \u043c\u0435\u0434\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0443\u043b\u044c\u0441, \u0441\u0442\u0440\u043e\u0431\u043e\u0441\u043a\u043e\u043f, \u0444\u043e\u0440\u043c\u044b \u0441\u0430\u043c\u0438 \u043f\u043e\u0434\u0441\u0432\u0435\u0442\u043a\u0438![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_091723_769ab65d.png) \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435 \u0432 \u043e\u0431\u0449\u0435\u043c \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0438 \u0441\u0432\u043e\u0431\u043e\u0434\u0430 \u0434\u043b\u044f \u043a\u0440\u0435\u0430\u0442\u0438\u0432\u0430.\n\n\u2022 \u0425\u043c, \u0447\u0442\u043e \u0437\u0430 \u043f\u043b\u0430\u043d \u0435\u0449\u0435 \u0442\u0430\u043a\u043e\u0439? \u0415\u0441\u043b\u0438 \u044d\u0442\u043e \u0441\u0443\u0431\u0441\u0430\u0439\u043f\u0435\u043d \u0442\u043e \u043f\u0443\u0441\u0442\u044c \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0441\u0432\u043e\u044e \u0447\u0430\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0438 \u0431\u0435\u0437 \u043f\u0440\u043e\u0431\u043b\u0435\u043c, \u0442\u0443\u0442 \u043f\u043b\u0430\u043d \u043d\u0435 \u043d\u0443\u0436\u0435\u043d, \u0442\u0443\u0442 \u043d\u0443\u0436\u0435\u043d \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.[2026-09-25_091215.png](file:///V:/___VAC/_PIC/_PRNTSCREEN/2026-09-25_091215.png)\n\n\u2022 \u041f\u043e\u043a\u0430 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043a\u043b\u0438\u043a\u0438 \u043d\u0430 ZAICODE ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_060714_33f0d1db.png) \u0438 \u043f\u0443\u0441\u0442\u044c \u0432\u043e\u043e\u0431\u0449\u0435 \u0431\u0443\u0434\u0435\u0442 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u044b\u0439 \u0438 \u0431\u044b\u0441\u0442\u0440\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043c\u044b\u043c. \u041a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u044f \u0445\u043e\u0447\u0443 \u043f\u0440\u043e\u0441\u0442\u043e \u0430\u0433\u0435\u043d\u0442\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0435 \u0442\u0430\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u043c\u0430\u0439\u043d\u0442\u0430\u0439\u043d\u0438\u0442, \u0438\u043b\u0438 \u0432 \u0441\u0435\u043a\u0446\u0438\u0438-\u0438\u044f\u0445 MAIN0-MAIN1 \u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u0442\u0430\u043c \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0432 \u043e\u0431\u0449\u0435\u043c \u0432\u0441\u0451 \u043f\u043e \u0443\u043c\u043d\u043e\u043c\u0443, \u043d\u043e \u043f\u043e\u043d\u044f\u0442\u043d\u043e\u043c\u0443 \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e\u043c\u0443 \u043d\u0443\u0436\u043d\u043e \u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f. \u042d\u0442\u043e\u0442 what to do, \u0447\u0442\u043e \u044f \u043f\u0438\u0448\u0443 \u0441\u043a\u0430\u0436\u0435\u043c \u0434\u043b\u044f implementer \u0442\u0430\u043c \u0438\u043b\u0438 \u0435\u0449\u0435 \u043a\u0430\u043a\u043e\u0433\u043e\u0442\u043e, \u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0447\u0443 \u0430\u0433\u0435\u043d\u0442\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 /goal cc all \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0443, \u044d\u0442\u043e \u043e\u0434\u0438\u043d \u0438\u0437 lazy \u0440\u0435\u0436\u0438\u043c\u043e\u043c \u0442\u0438\u043f\u043e hit and go \u0430 \u0442\u0430\u043c \u0443\u0436\u0435 \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442 \u043f\u043e\u0448\u0451\u043b \u0433\u0434\u0435 SAIPEN \u0432\u0441\u0451 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u0442 \u0447\u0442\u043e\u0431\u044b \u0444\u0430\u0431\u0440\u0438\u043a\u0430 \u043d\u0435 \u0432\u0437\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u044c \u0438 \u0437\u043e\u0432\u0451\u0442 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430 \u043a\u043e\u0433\u0434\u0430 \u043d\u0443\u0436\u043d\u043e. ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_091050_8999484c.png)![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_091343_47faffc0.png) - \u0442\u043e\u0435\u0441\u0442\u044c \u0434\u0430, \u043e\u043d \u043f\u043e \u0441\u0443\u0442\u0438 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043f\u043e\u0440\u0443\u0447\u0435\u043d\u043d\u0443\u044e \u0435\u043c\u0443 \u0437\u0430\u0434\u0430\u0447\u0443, \u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u043e SAIPEN \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e. \u0422\u043e\u0435\u0441\u0442\u044c \u0442\u0443\u0442 \u043c\u0430\u0441\u0442\u0435\u0440\u0441\u043a\u0430\u044f \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u044b\u0445 \u0430\u0433\u0435\u043d\u0442\u043e\u0432, \u0441 \u043a\u0443\u0447\u0438\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043b\u0435\u043a\u0433\u043e \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043c\u043e \u0438 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0439\u0448\u0435, \u0437\u0434\u0435\u0441\u044c \u0440\u043e\u0436\u0434\u0430\u044e\u0442\u0441\u044f SAIFREN SAIOPP SAIROUTE SAIAGENTS \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0434\u0435\u0440\u0436\u0430\u0442 \u043f\u0440\u043e\u0435\u043a\u0442\u044b \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e.\n\n\u2022 \u041f\u043e \u0441\u0443\u0442\u0438 \u0434\u0430, ZAICODE \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0442\u0430\u043c \u0435\u0449\u0435 \u0442\u043e\u0433\u0434\u0430 \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u0447\u043d\u044b\u0435 oauth \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u0442\u043e\u0436\u0435 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432 AI Limit meters \u0442\u0430\u043c \u043d\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044c \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043c\u0435\u0439\u043d\u0442\u0435\u0439\u043d\u0438\u043b \u0438 \u0441\u0442\u043e\u0440\u043e\u0436\u0438\u043b \u0441\u0432\u043e\u044e \u0447\u0430\u0441\u0442\u044c, \u0441\u0432\u043e\u0439 \u043f\u0440\u043e\u0435\u043a\u0442, \u0432\u043e \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u0430\u0442\u044c, \u043a\u043e\u0433\u0434\u0430 \u0438 \u043f\u043e\u0447\u0435\u043c\u0443, \u043a\u043e\u0433\u0434\u0430 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u0442\u044c, SAIPEN \u0442\u0443\u0442 \u0431\u043e\u043d\u0443\u0441\u043e\u043c \u0438\u0434\u0451\u0442 \u043a\u043e\u043d\u0435\u0447\u043d\u043e \u0436\u0435 \u0447\u0442\u043e\u0431\u044b \u044d\u0442\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0442\u044c \u0432\u0441\u0451, scheduled upon limit resets \u043d\u0430\u0447\u0438\u043d\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0443 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0441 goal \u0442\u0430\u043c, \u0432 \u043e\u0431\u0449\u0435\u043c \u043f\u043e\u043b\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e\u0441\u0442\u044c.\n\n\u2022 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20260925_090234_7cf32e10.png) \u041d\u0430\u043f\u043e\u043c\u043d\u044e, \u0447\u0442\u043e \u0445\u043e\u0442\u0435\u043b \u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0442\u0430\u043a \u043a\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u0432 \u043e\u0431\u044b\u0447\u043d\u043e\u043c \u0447\u0430\u0442\u0435 \u0431\u0435\u0437 \u0432\u0441\u044f\u043a\u0438\u0445 WORKERS \u0432\u043e\u043e\u0431\u0449\u0435, \u0447\u0442\u043e\u0431\u044b \u043c\u0435\u043d\u044c\u0448\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0441\u0440\u0435\u04
    "SRC-123:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 Scheduler: \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u044b \u043d\u0443\u0436\u043d\u043e \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430 Autopilot \u044e\u0437\u0435\u0440\u0443 \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u0431\u044b\u043b \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0435\u0441\u043b\u0438 \u043e\u043d \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u043e, \u0438\u0431\u043e \u0441 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442\u043e\u043c \u0442\u043e\u0433\u0434\u0430 \u0441\u043c\u044b\u0441\u043b \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u0438 \u044d\u0442\u043e \u043f\u043e\u043a\u0430 \u043d\u0435\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u043d\u043e\u0447\u044c \u0432\u0441\u0451 \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u0438\u043f\u043e \u043f\u0438\u0448\u0435\u0442 \"Next in x hours\" \u0430 \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442 \u0437\u0430\u0431\u044b\u043b \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0442 \u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e \u0442\u0438\u043f\u043e \u0432\u043e\u0442 \u0431\u0443\u0434\u0435\u0442 \u0434\u0430 \u0430 \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043b\u043e\u0436\u044c \u0431\u0435\u0437 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442\u0430. \u041d\u0443\u0436\u043d\u043e \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c \u0430 \u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430.\n\n\u2022 Auto ON \u0441\u043f\u0430\u0432\u043d\u0438\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u044d\u0442\u0438 collects ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20261003_035812_7c0d762d.png) - \u044d\u0442\u043e \u0431\u0430\u0433 p0\n\n\u2022 \u042f \u0431\u044b \u0445\u043e\u0442\u0435\u043b \u0443\u0431\u0440\u0430\u0442\u044c Hovers \u0433\u0434\u0435 \u0442\u0430\u043c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0447\u0442\u043e \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0442\u043e \u0447\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u044d\u0442\u043e \u0434\u0443\u0431\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u043e\u0442 \u043f\u0440\u0438\u043c\u0435\u0440 ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_202610\u2022 Scheduler: \u0415\u0441\u043b\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u044b \u043d\u0443\u0436\u043d\u043e \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430 Autopilot \u044e\u0437\u0435\u0440\u0443 \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u0431\u044b\u043b \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0435\u0441\u043b\u0438 \u043e\u043d \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u043e, \u0438\u0431\u043e \u0441 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044b\u043c \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442\u043e\u043c \u0442\u043e\u0433\u0434\u0430 \u0441\u043c\u044b\u0441\u043b \u0442\u0435\u0440\u044f\u0435\u0442\u0441\u044f \u0438 \u044d\u0442\u043e \u043f\u043e\u043a\u0430 \u043d\u0435\u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u043e \u044f \u043f\u043e\u0441\u0442\u0430\u0432\u0438\u043b \u043d\u0430 \u043d\u043e\u0447\u044c \u0432\u0441\u0451 \u0432\u043a\u043b\u044e\u0447\u0438\u043b \u0442\u0438\u043f\u043e \u043f\u0438\u0448\u0435\u0442 \"Next in x hours\" \u0430 \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442 \u0437\u0430\u0431\u044b\u043b \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0442 \u0430 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u043e \u0442\u0438\u043f\u043e \u0432\u043e\u0442 \u0431\u0443\u0434\u0435\u0442 \u0434\u0430 \u0430 \u044d\u0442\u043e \u0431\u044b\u043b\u0430 \u043b\u043e\u0436\u044c \u0431\u0435\u0437 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0430\u0432\u0442\u043e\u043f\u0438\u043b\u043e\u0442\u0430. \u041d\u0443\u0436\u043d\u043e \u044d\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u043c \u0430 \u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0443\u0442\u0430\u043d\u0438\u0446\u0430.\n\n\u2022 Auto ON \u0441\u043f\u0430\u0432\u043d\u0438\u0442 \u0431\u0435\u0441\u043a\u043e\u043d\u0435\u0447\u043d\u043e \u044d\u0442\u0438 collects ![](file:///V:/___VAC/_PIC/_Clipboard_stuff/clipboard_20261003_035812_7c0d762d.png) - \u044d\u0442\u043e \u0431\u0430\u0433 p0\n\n\u2022 \u042f \u0431\u044b \u0445\u043e\u0442\u0435\u043b \u0443\u0431\u0440\u0430\u0442\u044c Hovers \u0433\u0434\u0435 \u0442\u0430\u043c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0447\u0442\u043e \u044d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c \u0442\u043e \u0447\u0442\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u044d\u0442\u043e \u0434\u0443\u0431\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0432\u043e\u0442 \u043f\u0440\u0438\u043c\u0435\u0440
{
  "clauses": {
    "SRC-153:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041f\u043e\u043a\u0430 \u0447\u0442\u043e \u043e\u0447\u0435\u043d\u044c \u043d\u0435\u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0443\u0435\u043c\u043e \u0441\u0435\u0431\u044f \u0432\u0435\u0434\u0451\u0442 \u044d\u0442\u0430 \u043a\u043d\u043e\u043f\u043a\u0430 auto retry \u043d\u0430\u0436\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043d\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f. \u041d\u0443\u0436\u043d\u043e \u043f\u0440\u043e\u0449\u0435 \u0438 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0443\u0437\u0435\u043c\u0435\u0435 \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u043b\u043e \u0442\u043e\u0447\u043d\u043e. ![](media/001_clipboard_20261005_194659_a8dd4995.png)"
    },
    "SRC-153:R002": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u043d\u043e \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c \u0442\u0430\u043a\u0438\u0435 \u043f\u0440\u0438\u043a\u043e\u043b\u044b \u0442\u043e\u0436\u0435, \u043f\u0443\u0441\u0442\u044c auto goal \u0431\u0443\u0434\u0435\u0442 \u0443\u043c\u043d\u0435\u0435 \u043d\u0435\u043d\u043c\u043e\u0433\u043e ![](media/002_clipboard_20261005_194506_ba049648.png)"
    },
    "SRC-153:R003": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041f\u043e \u0438\u0434\u0435\u0435 Auto \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u043e \u0441\u043b\u0435\u0434\u0438\u0442 \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b goal cc all \u0432\u0435\u0437\u0434\u0435 \u0431\u044b\u043b \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d \u0434\u043e \u043a\u043e\u043d\u0446\u0430."
    },
    "SRC-153:R004": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 ProTrail \u0442\u043e\u0436\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u043a\u043d\u043e\u043f\u043a\u043e\u0439 Save all \u0432 \u043a\u043d\u043e\u043f\u043a\u0435 ZAICODE \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u0447\u0438\u043a\u0430 \u0434\u043b\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0431\u0438\u043b\u0434\u0430 \u0438 \u0432\u0441\u0435 \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u043e\u0436\u0435. \u0422\u043e\u0435\u0441\u0442\u044c \u0432\u043e\u0442 \u0442\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0449\u0430\u0441 \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e \u0432\u0441\u0451 \u0434\u043e\u043b\u0436\u043d\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u0441\u0451 \u0434\u043e \u0435\u0434\u0438\u043d\u043e\u0433\u043e, ProTrail motion wake OFF \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    },
    "SRC-153:R005": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u0435\u043d \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440 \u0447\u0442\u043e \u0441\u0435\u0441\u0441\u0438\u044f \u043e\u0431\u043e\u0440\u0432\u0430\u043b\u0430\u0441\u0441\u044c \u0441\u0432\u044f\u0437\u044c \u0441 API \u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u0432\u043c\u0435\u0441\u0442\u043e \u043b\u043e\u0436\u043d\u043e\u0433\u043e \"\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0449\u0430\u0441\"."
    },
    "SRC-153:R006": {
      "actionable": true,
      "class": "requirement",
      "text": "--- \u2022 \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435\u0442 \u0444\u043e\u043b\u0431\u0435\u043a\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e ![](media/003_clipboard_20261005_021327_245012af.png)"
    },
    "SRC-153:R007": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c composer \u043d\u0435 \u0432\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043d\u0443\u0436\u043d\u044b\u0435 \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0443\u0441\u0442\u044c \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u0443\u0434\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e ![](media/004_clipboard_20261005_001158_916a165b.png)"
    },
    "SRC-153:R008": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0411\u044b\u0432\u0430\u0435\u0442 \u0435\u0449\u0435 ProTrail \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0441\u0430\u043c\u044b\u0439 \u0437\u0430\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0437\u0430 \u0432\u0441\u0435\u043c\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c\u0438 \u0431\u0443\u0434\u0442\u043e \u0438 \u043b\u0435\u0447\u0438\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c."

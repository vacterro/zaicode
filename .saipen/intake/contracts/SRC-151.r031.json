    "SRC-151:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0414\u043e \u0441\u0438\u0445 \u043f\u043e\u0440 \u043d\u0435\u0442 \u0444\u043e\u043b\u0431\u0435\u043a\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e ![](media/001_clipboard_20261005_021327_245012af.png)"
    },
    "SRC-151:R002": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c composer \u043d\u0435 \u0432\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b \u043d\u0443\u0436\u043d\u044b\u0435 \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0443\u0441\u0442\u044c \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438 \u0431\u0443\u0434\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e ![](media/002_clipboard_20261005_001158_916a165b.png)"
    },
    "SRC-151:R003": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0411\u044b\u0432\u0430\u0435\u0442 \u0435\u0449\u0435 ProTrail \u0438\u043d\u043e\u0433\u0434\u0430 \u0443\u0445\u043e\u0434\u0438\u0442 \u043d\u0430 \u0441\u0430\u043c\u044b\u0439 \u0437\u0430\u0434\u043d\u0438\u0439 \u043f\u043b\u0430\u043d \u0437\u0430 \u0432\u0441\u0435\u043c\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c\u0438 \u0431\u0443\u0434\u0442\u043e \u0438 \u043b\u0435\u0447\u0438\u0442\u0441\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u043e\u043c."
    },
    "SRC-151:R004": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0442\u0430\u043a\u043e\u0439 \u0431\u0430\u0433 \u043a\u043e\u0433\u0434\u0430 \u043c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u044e \u043e\u043a\u043d\u043e \u0430 \u043e\u043d\u043e \u0432\u043e\u0442 \u0442\u0430\u043a \u043c\u0430\u043a\u0441\u0438\u043c\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f ![](media/003_clipboard_20261004_201704_126aea3e.png) ![](media/004_clipboard_20261004_201606_bcb06d39.png) ![](media/005_clipboard_20261004_233630_193397e8.png)"
    },
    "SRC-151:R005": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0432\u0441\u0451 \u0435\u0449\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0447\u0442\u043e \"\u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\" \u043d\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u043c \u0434\u0435\u043b\u0435 \u0443\u0436\u0435 \u0437\u0430\u043a\u043e\u043d\u0447\u0438\u043b \u0440\u0430\u0431\u043e\u0442\u0443 ![](media/006_clipboard_20261004_184012_f4829648.png)"
    },
    "SRC-151:R006": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c \u043a\u043e\u0433\u0434\u0430 \u0430\u0432\u0442\u043e goal cc all \u0432\u043a\u043b\u044e\u0447\u0435\u043d \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e \u044d\u0442\u043e ![](media/007_clipboard_20261004_181959_a300c5bb.png) \u0432 queued \u0441\u0442\u0440\u043e\u043a\u0435 \u043f\u0438\u0448\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e goal cc all \u0433\u0434\u0435 \u043d\u0435\u0442 \u0434\u0430\u0436\u0435 ![](media/008_clipboard_20261004_182041_197b0fe1.png) \u0438\u043d\u0434\u0438\u043a\u0430\u0442\u043e\u0440\u0430 \u0447\u0442\u043e \u0442\u0430\u043c \u0444\u0430\u0439\u043b \u0432\u043b\u043e\u0436\u0435\u043d - \u044d\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c"
    },
    "SRC-151:R007": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 ZAICODE \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0446\u0435\u043d\u043d\u0443\u044e \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0443 \u043d\u043e\u0432\u043e\u0433\u043e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432 real time \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0447\u0442\u043e\u0431\u044b \u0432\u0441\u0451 \u043f\u043e\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u043b\u043e\u0441\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0438 \u043d\u0430\u0434\u0451\u0436\u043d\u043e. \u042f \u0432\u043e\u0442 \u0437\u0430\u0448\u0451\u043b \u0432\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u0433\u0443\u0433\u043b \u0430\u043a\u043a\u0430\u0443\u043d\u0442 \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u0432 SAITULS Accounts, \u0430 ZAICODE \u0435\u0449\u0435 \u0432\u0438\u0434\u0438\u043c\u043e \u0441\u0442\u0430\u0440\u0443\u044e \u0438\u043c\u0435\u0435\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u043a\u0443 \u0447\u0442\u043e \u043f\u0443\u0442\u0430\u0435\u0442. ![](media/009_clipboard_20261004_181625_42c3f7c2.png) - \u0434\u0430\u0436\u0435 \u043d\u0435\u0442 \u0437\u0430\u0439\u0442\u0438\u0438 \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u043e\u0432 \u043e\u0434\u043d\u043e\u0433\u043e \u0432\u0435\u043d\u0434\u043e\u0440\u0430 \u0442\u043e\u043a\u0430 Codex \u0438 Claude \u0432\u0438\u0436\u0443 \u0438 \u0432\u0441\u0451, \u043d\u0443\u0436\u043d\u043e \u0432 \u043e\u0431\u0449\u0435\u043c \u044d\u0442\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u0433\u0440\u0430\u043c\u043e\u0442\u043d\u043e."
    },
    "SRC-151:R008": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 ZAICODE \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c A3 audit wave \u0432\u043e\u043e\u0431\u0449\u0435 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u043c\u044b\u043c toggleable \u0447\u0442\u043e\u0431\u044b \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u043d\u0435 \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b auto conitnue/continue all \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0438 \u044d\u0442\u043e \u0434\u043e\u043b\u0436\u043d \u0431\u044b\u0442\u044c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e, \u0442\u043e\u0435\u0441\u0442\u044c \u0441\u043a\u0430\u0436\u0435\u043c \u0432\u043a\u043b\u0430\u0434\u043a\u0430 Audit \u0432 ZAICODE \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0430\u044f enabled disabled."
    },
    "SRC-151:R009": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041a\u043d\u043e\u043f\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u043d\u0430\u043b\u0435\u0437\u0430\u0442\u044c \u043d\u0430 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 ![](media/010_clipboard_20261004_174154_55be341c.png)"
    },
    "SRC-151:R010": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0422\u0443\u043b\u0442\u0438\u043f\u044b \u043c\u043e\u0433\u0443\u0442 \u0441\u043f\u0430\u0432\u043d\u0438\u0442\u044c\u0441\u044f \u0432\u043b\u0435\u0432\u043e\u043c \u0432\u0435\u0440\u0445\u043d\u0435\u043c \u0443\u0433\u043b\u0443 \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f ![](media/011_clipboard_20261004_174024_4b027ca7.png)"
    },
    "SRC-151:R011": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041f\u0440\u0430\u0432\u0430\u044f \u043a\u043d\u043e\u043f\u043a\u0430 \u0437\u0434\u0435\u0441\u044c \u0434\u043e\u043b\u0436\u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u044d\u0442\u0438\u0445 \u043a\u043d\u043e\u043f\u043e\u043a ![](media/012_clipboard_20261004_170234_1bc7317c.png) - \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0443\u0436\u043d\u043e \u0432\u0435\u0437\u0434\u0435 \u0442\u0430\u043a\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u0433\u0434\u0435 \u044e\u0437\u0435\u0440 \u043e\u0436\u0438\u0434\u0430\u0435\u0442 \u043d\u0430 \u043f\u0440\u0430\u0432\u0443\u044e \u043a\u043d\u043e\u043f\u043a\u0443 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0434\u0430\u043d\u043d\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u0438 \u0433\u0434\u0435 \u044d\u0442\u043e \u0432 \u0431\u043e\u043b\u044c\u0448\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e \u0432\u0435\u0437\u0434\u0435 \u0432 ZAICODE. \u0422\u043e\u0435\u0441\u0442\u044c \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0442\u043e\u0433\u0433\u043b \u043f\u0440\u0430\u0432\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u043d\u0430 3 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0440\u0435\u0436\u0438\u043c\u0430 \u0438\u043b\u0438 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u0449\u0430\u0441 \u0438\u043b\u0438 \u0432\u043e\u0442 \u0442\u0430\u043a \u043a\u0430\u043a \u0445\u043e\u0442\u0435\u043b \u0431\u044b."
    },
    "SRC-151:R012": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0422\u0430\u043a\u0438\u0435 \u0432\u043e\u0442 \u0433\u0438\u0433\u0430\u043d\u0442\u0441\u043a\u0438\u0435 \u0442\u0443\u043b\u0442\u0438\u043f\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b ![](media/013_clipboard_20261004_165948_96738f62.png)"
    },
    "SRC-151:R013": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 Scheduler Continuinity: \u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0435\u0439 \u0434\u043b\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u043d\u0430\u0434 \u043e\u0434\u043d\u0438\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c. \u0422\u0435\u043f\u0435\u0440\u044c \u043d\u0443\u0436\u043d\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b ZAICODE \u0443\u043c\u0435\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0442\u044c \u043a\u043e\u0433\u0434\u0430 \u0435\u0441\u043b\u0438 \u043e\u0434\u0438\u043d \u0432\u043e\u0440\u043a\u0435\u0440 \u0443\u043f\u0451\u0440\u0441\u044f \u0432 \u043b\u0438\u043c\u0438\u0442 (\u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c \u0442\u0430\u043c \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u0447\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0432 \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0441\u0435\u0441\u0441\u0438 \u0432 \u043d\u043e\u043b\u044c) \u0442\u043e\u0433\u0434\u0430 \u0434\u043e\u0431\u0430\u0432\u0438\u0442\u044c \u0434\u0430\u043b\u044c\u0448\u0435 \u0446\u0435\u043f\u043e\u0447\u043a\u0443 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0443\u044e \u043f\u043e\u0434\u043f\u0438\u0441\u043e\u0447\u043d\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0435\u043d\u0434\u043e\u0440\u0430 \u0441\u043b\u0435\u0434\u043e\u043c \u0441 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0439 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u043e\u0439 \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430\u0434 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u043c \u0438 vice versa \u0432 \u043e\u0431\u0449\u0435\u043c \u0442\u0443\u0442 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0431\u043e\u043b\u044c\u0448\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f, \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0435\u0439."
    },
    "SRC-151:R014": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0415\u0449\u0435 \u043d\u0443\u0436\u043d\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0432 \u043c\u043e\u0439 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 9router - \u043e\u043d \u0447\u0451\u0442 \u043a\u0440\u0430\u0448\u0438\u0442\u0441\u044f \u0441 \u043d\u0438\u0445\u0440\u0435\u043d\u0430 \u0438 \u0432\u0441\u0451 \u043d\u043e\u0447\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u0442\u043e\u0438\u0442, \u0430 fallback \u043d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e ZAICODE \u043f\u044b\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f \u0432 \u043d\u0435\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u0440\u0443\u0442\u0435\u0440 \u0441\u043d\u043e\u0432\u0430 \u0438 \u0441\u043d\u043e\u0432\u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u043d\u043e\u0440\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u043d\u0430 \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u0445\u043e\u0442\u044f\u0431\u044b, \u0430 \u043b\u0443\u0447\u0448\u0435 \u043f\u0443\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439, \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u043e\u0431\u0440\u0430\u0442\u043d\u043e silently. \u0429\u0430\u0441 \u043f\u0440\u043e\u0441\u043d\u0443\u043b\u0441\u044f \u0443\u0442\u0440\u043e\u043c \u0438 \u0432\u0438\u0436\u0443 \u0447\u0442\u043e 9router \u0438\u0441\u0447\u0435\u0437 \u0430 ZAICODE \u0432\u0441\u0451 \u044d\u0442\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u043c\u0435\u0441\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u0430\u0442\u044c \u0438\u043d\u0444\u0435\u0440\u0435\u043d\u0441 \u0438\u0437 \u0432\u043e\u0437\u0434\u0443\u0445\u0430. \u042d\u0442\u043e \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e. \u042d\u0442\u043e \u043f\u0440\u043e\u0432\u0430\u043b \u0438 \u043f\u043e\u0442\u0435\u0440\u044f \u0434\u0440\u0430\u0433\u043e\u0446\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0443\u043b\u0435\u0442\u0435\u0432\u0448\u0435\u0433\u043e \u0432 \u043f\u0443\u0441\u0442\u0443\u044e, \u0445\u043e\u0442\u044f \u043c\u043e\u0433 \u043f\u0440\u043e\u0441\u043d\u0443\u0442\u044c\u0441\u044f \u0441 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u043c. \u0422\u0430\u043a\u043e\u0433\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u0442\u044c\u0441\u044f \u0438 ZAICODE \u0434\u043e\u043b\u0436\u0435\u043d \u0434\u0435\u043b\u0430\u0442\u044c \u043f\u043e\u043f\u044b\u0442\u043a\u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0439 9router \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 10 \u0440\u0430\u0437, \u0430 \u043f\u043e\u0442\u043e\u043c \u0443\u0436\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u0441\u044f \u043d\u0430 fallback \u0447\u0435\u0440\u0435\u0437 \u0441\u0432\u043e\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439."
    },
    "SRC-151:R015": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u044f \u0431\u044b \u0432\u043e\u043e\u0431\u0449\u0435 \u0445\u043e\u0442\u0435\u043b \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044c\u0441\u044f \u043e\u0442 \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u0445 \u0441\u0438\u0440\u043e\u0442 \u0441\u0435\u0441\u0441\u0438\u0439 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u043f\u0430\u0432\u043d\u044f\u0442\u0441\u044f \u0438 \u0432\u0438\u0441\u044f\u0442 \u0435\u0441\u043b\u0438 \u0443 \u043c\u0435\u043d\u044f main \u0440\u0435\u0436\u0438\u043c (3\u0438\u0439) \u0441\u0442\u043e\u0438\u0442 \u043d\u0430\u0434\u043e\u0435\u043b\u043e \u0438\u0445 \u0447\u0438\u0441\u0442\u0438\u0442\u044c \u0440\u0443\u043a\u0430\u043c\u0438 \u0438\u0445 \u043f\u043e \u0438\u0434\u0435\u0435 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043e\u043d\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c\u0441\u044f ![](media/014_clipboard_20261004_163247_ec7a28f8.png) - \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0430 \u0441\u043a\u0440\u0438\u043d\u0448\u043e\u0442\u0435  \u044f\u0432\u043d\u043e \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0430 \u0433\u0430\u043b\u043e\u0447\u043a\u0430 - \u044d\u0442\u043e \u0433\u043b\u0430\u0432\u043d\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f \u043d\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u043f\u043b\u043e\u0434\u0438\u0442 child \u0433\u0434\u0435 \u0441\u0435\u0441\u0441\u0438\u044f \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u0430 \u043d\u0443\u0436\u043d\u043e \u0432\u043e\u0442 \u0442\u0430\u043a: ![](media/015_clipboard_20261004_164936_8748593c.png) - \u043a\u0440\u0430\u0441\u0438\u0432\u043e \u0438 \u0447\u0451\u0442\u043a\u043e, \u0432 \u0440\u044f\u0434, \u0431\u0435\u0437 \u043b\u0438\u0448\u043d\u0435\u0439 \u043c\u0438\u0448\u0443\u0440\u044b, \u0431\u0435\u0437 \u0433\u043e\u0432\u043d\u0430, \u0431\u0435\u0437 \u0448\u0443\u043c\u0430."
    },
    "SRC-151:R016": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0441\u0435\u0441\u0441\u0438\u0438 \u0447\u0438\u0441\u0442\u0438\u043b\u043a\u0430 \u0432\u0435\u0440\u043d\u0435\u0435 \u043d\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u043a\u0443\u043d\u0434 \u044d\u0442\u043e\u0442 \u043f\u043e\u043f\u0430\u043f \u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0447\u0430\u0441\u0442\u044c \u0441\u0430\u0439\u0434\u0431\u0430\u0440\u0430 \u0447\u0442\u043e \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e ![](media/016_clipboard_20261004_163101_60d06f2f.png) ![](media/017_clipboard_20261004_163337_be94ce2a.png)"
    },
    "SRC-151:R017": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0435 \u043d\u0430\u0436\u0430\u043d\u0438\u0435 \u043d\u0430 \u044d\u0442\u0443 \u043a\u043d\u043e\u043f\u043a\u0443 \u0434\u043e\u043b\u0436\u043d\u043e \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u0441\u043a\u0440\u044b\u0432\u0430\u0442\u044c \u044d\u0442\u043e\u0442 sidebar ![](media/018_clipboard_20261004_163019_44b39384.png) "
    },
    "SRC-151:R018": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041f\u0440\u0438\u043a\u043e\u043b: \u041f\u0438\u0448\u0435\u0442 auto retry on \u0430 \u043f\u043e \u0444\u0430\u043a\u0442\u0443 off ![](media/019_clipboard_20261004_060205_812a3ed5.png)"
    },
    "SRC-151:R019": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0435\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0439 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0430\u0432\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0442\u0435\u043a\u0441\u0442 ![](media/020_clipboard_20261004_052005_c07e138d.png) \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0441\u043b\u0438 \u0442\u0438\u043f\u043e \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0442\u043e \u043e\u043d \u0441\u043a\u0438\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0444\u0430\u0439\u043b\u043e\u043c, \u0430 \u044d\u0442\u043e\u0442 \u0444\u0430\u0439\u043b \u0442\u0435\u043f\u0435\u0440\u044c \u043a\u0430\u043a\u0431\u044b \u0443\u0432\u0435\u043a\u043e\u0435\u0432\u0435\u0447\u0435\u043d \u0438 \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0432\u043e\u043e\u0431\u0449\u0435 \u0438 \u043d\u0435 \u043f\u043e\u043d\u044f\u0442\u043d\u043e \u0447\u0442\u043e \u0442\u0430\u043c \u0442\u0435\u043f\u0435\u0440\u044c \u0447\u0442\u043e \u044f \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b."
    },
    "SRC-151:R020": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0415\u0449\u0435 \u043d\u0435\u043f\u0440\u0438\u044f\u0442\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u043a\u043e\u0433\u0434\u0430 \u044f \u043d\u0430\u0445\u043e\u0436\u0443\u0441\u044c \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0435/\u0441\u0435\u0441\u0441\u0438\u0438 - \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u043b\u0441\u044f \u043d\u0430 zaicode/scheduler/saihome - \u0434\u0430\u043b\u044c\u0448\u0435 \u0441\u043d\u043e\u0432\u0430 \u043f\u044b\u0442\u0430\u044e\u0441\u044c \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u043d\u0430 \u0442\u0443 \u0436\u0435 \u0441\u0435\u0441\u0441\u0438\u044e \u043d\u043e \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0438 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u0442 \u043f\u043e\u043a\u0430 \u044f \u043f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0443\u0441\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u0443\u044e \u0441\u043e\u0432\u0440\u0435\u0448\u0435\u043d\u043d\u043e \u0441\u0435\u0441\u0441\u0438\u044e \u0438 \u0441\u043d\u043e\u0432\u0430 \u0435\u0441\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043d\u0430 \u0438\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0435\u0441\u0441\u0438\u044e, \u044d\u0442\u043e \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e."
    },
    "SRC-151:R021": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0412\u043e\u0442 \u0437\u0434\u0435\u0441\u044c \u044f \u0431\u044b \u0445\u043e\u0442\u0435\u043b \u0435\u0449\u0435 \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u043e 5h/weekly \u0442\u043e\u0436\u0435 \u043f\u043e\u043b\u043e\u0441\u043a\u0438 \u0432\u0438\u0434\u0435\u0442\u044c \u0443 \u0432\u043e\u0440\u043a\u0435\u0440\u0430 \u0447\u0442\u043e\u0431\u044b \u0432\u0438\u0434\u0435\u0442\u044c \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0442\u0430\u043c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u043e \u0443 \u044d\u0442\u043e\u0433\u043e \u0432\u043e\u0440\u043a\u0435\u0440\u0430 \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442 \u043b\u0438\u043c\u0438\u0442\u043e\u0432 ![](media/021_clipboard_20261004_034635_b5e9e055.png)"
    },
    "SRC-151:R022": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u043d\u043e \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u0442\u0435\u043c\u044b \u0442\u0430\u043a\u0436\u0435 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0443\u043f\u0440\u043e\u0449\u0451\u043d\u043d\u044b\u0439 \u0440\u0435\u0436\u0438\u043c \u0431\u0435\u0437 Bevels \u0441\u0442\u0438\u043b\u044f \u043a\u0430\u043a \u0442\u0443\u0442 \u043a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 ![](media/022_clipboard_20261004_022932_56afc296.png) \u043d\u043e \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043e\u0431\u044b\u0447\u043d\u044b\u0435 box-like-\u0440\u0430\u043c\u043a\u0438 \u0438 \u0435\u0449\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u043d\u0430 \u0442\u0432\u043e\u0439 \u0432\u044b\u0431\u043e\u0440 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442 \u043f\u043e \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443."
    },
    "SRC-151:R023": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u043d\u043e \u0437\u0434\u0435\u0441\u044c \u043f\u0435\u0440\u0435\u043d\u0435\u0441\u0442\u0438 \u043a\u0443\u0434\u0430 \u043d\u0438\u0431\u0443\u0434\u044c \u044d\u0442\u043e\u0442 COLLECT \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u043e\u043d\u043e \u0431\u044b\u043b\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u0432 \u043d\u0438\u0436\u043d\u0438\u0439 \u0440\u044f\u0434, \u0438\u0431\u043e \u043e\u043d\u043e \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0435\u0442 \u043b\u0438\u0448\u043d\u0443\u044e \u043f\u0443\u0441\u0442\u0443\u044e \u0441\u0442\u0440\u043e\u043a\u0443 \u0447\u0442\u043e \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043c\u043d\u043e\u0433\u043e \u043c\u0435\u0441\u0442\u0430 \u0438 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0435\u0442 \u043f\u0443\u0441\u0442\u043e\u0435 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u043e \u0432 \u0438\u0442\u043e\u0433\u0435 \u0440\u0430\u0434\u0438 \u044d\u0442\u0438\u0445 \u0434\u0432\u0443\u0445 \u043a\u043d\u043e\u043f\u043e\u043a. \u041a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0435\u0435, \u043a\u043e\u043c\u043f\u0430\u043a\u0442\u043d\u0435\u0435."
    },
    "SRC-151:R024": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c \u043f\u0440\u0438 sidebar \u0435\u0441\u043b\u0438 \u043c\u0435\u043d\u044f\u044e \u043c\u0435\u0441\u0442\u0430\u043c\u0438 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0442\u043e\u0433\u0434\u0430 \u043a\u043d\u043e\u043f\u043a\u0438 \u043d\u0435 \u043c\u0438\u0433\u0440\u0438\u0440\u0443\u044e\u0442 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u044d\u0442\u043e \u043f\u0440\u043e\u0441\u0447\u0451\u0442 ![](media/023_clipboard_20261004_012011_fc121c37.png)"
    },
    "SRC-151:R025": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0412\u043a\u043b\u0430\u0434\u043a\u0430 Workers \u0447\u0442\u043e \u0441\u043a\u0440\u044b\u0442\u0430\u044f \u0447\u0442\u043e \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u0430\u044f \u043d\u0435 \u0434\u0430\u0451\u0442 \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u044d\u0444\u0444\u0435\u043a\u0442\u0430 \u0432\u043e\u043e\u0431\u0449\u0435. ![](media/024_clipboard_20261003_235423_ccc7f2b6.png)"
    },
    "SRC-151:R026": {
      "actionable": false,
      "class": "context",
      "text": "[x] ~~\u2022 p0 - \u041f\u0440\u0435\u0441\u0435\u0442\u044b \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0443, \u044d\u0442\u043e \u0441\u0440\u044b\u0432\u0430\u0435\u0442 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0435 \u0441\u0435\u0441\u0441\u0438\u0438 \u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u044b.~~"
    },
    "SRC-151:R027": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u041d\u0443\u0436\u043d\u043e \u0443\u0431\u0440\u0430\u0442\u044c irrelevant \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u0435\u043a\u0446\u0438\u0438 \u0432 \u0441\u0430\u043c\u044b\u0439 \u043d\u0438\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e \u0432\u0430\u0436\u043d\u043e\u0441\u0442\u0438 \u0432\u043e \u0432\u0441\u0435\u0445 \u0441\u0435\u043a\u0446\u0438\u044f\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438. \u041a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 \u0442\u0443\u0442 SAIASUI \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u0440\u0430\u0437\u0443 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445, \u044d\u0442\u043e \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0442\u0430\u043a, \u044e\u0437\u0435\u0440 \u043d\u0435 \u0437\u0430 \u0438\u0433\u0440\u043e\u0439 \u043f\u0440\u0438\u0448\u0451\u043b. \u041f\u0443\u0441\u0442\u044c \u043e\u043d\u043e \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0435 \u0441\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u043c\u044b\u043c \u0438 \u0441\u0432\u0435\u0440\u043d\u0443\u0442\u043e \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0438 \u0442\u0430\u043a \u0432\u0435\u0437\u0434\u0435 ![](media/026_clipboard_20261003_232015_f4ef7d2a.png)"
    },
    "SRC-151:R028": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0412\u043e\u0442 \u0437\u0434\u0435\u0441\u044c \u0432 usage \u043f\u0430\u043d\u0435\u043b\u0435 \u043c\u0435\u0442\u0440\u0435 live \u0441\u0434\u0435\u043b\u0430\u0439 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435 \u0442\u043e\u043a\u0430 \u0432\u043c\u0435\u0441\u0442\u043e \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0433 10 \u0441\u0435\u043a, \u043d\u043e \u0438 5, 3, 2, 1 \u0441\u0435\u043a; \u0423\u0431\u0435\u0440\u0438 \"Done\" \u043f\u043e\u0434\u043e\u0431\u043d\u043e\u0435 \u0441\u043b\u043e\u0432\u043e - \u043e\u043d\u043e \u043d\u0435 \u043d\u0443\u0436\u043d\u043e \u0435\u0441\u043b\u0438 99,99% \u0432\u0441\u0435\u0433\u0434\u0430 \"done\", \u0434\u043e\u0431\u0430\u0432\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0441\u0448\u0438\u0440\u044f\u0442\u044c-\u0438\u0437\u043c\u0435\u043d\u044f\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \u0448\u0438\u0440\u0438\u043d\u044b \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0447\u0442\u043e\u0431\u044b \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u0445\u043e\u0447\u0435\u0442 \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0438\u043b\u0438\u0438 \u0434\u0440\u0443\u0433\u043e\u0435 \u0442\u0430\u043c \u0432\u043c\u0435\u0449\u0430\u043b\u043e\u0441\u044c \u0438 \u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0435."
    },
    "SRC-151:R029": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0422\u0430\u043a\u0436\u0435 \u0434\u043e\u0431\u0430\u0432\u044c \u0432 \u043a\u043e\u043c\u043f\u043e\u0437\u0435\u0440 \u043a\u043d\u043e\u043f\u043a\u0443 \u043a\u0430\u043a Auto-Goal \u0440\u0435\u0436\u0438\u043c: \u041e\u043d\u043e \u0437\u0430\u0434\u0430\u0451\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443 \u0441 \u043b\u044e\u0431\u044b\u043c \u043f\u0440\u043e\u043c\u043f\u0442\u043e\u043c \u0432\u043e\u043e\u0431\u0449\u0435 \u0441\u043a\u0440\u044b\u0442\u043d\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0442\u043e \u044e\u0437\u0435\u0440 \u0432\u0435\u0437\u0434\u0435 \u0432 \u043a\u043e\u043d\u0446\u0435 \u043f\u0438\u0448\u0435\u0442 \"goal cc all\" \u043d\u043e \u044d\u0442\u043e \u043d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f. \u0422\u0430\u043a\u0436\u0435 \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u043e \u0435\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0442\u043e\u0433\u0434\u0430 \u043f\u043e\u0434\u0441\u0432\u0435\u0447\u0435\u043d\u043e, \u0430 \u0435\u0441\u043b\u0438 \u043d\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043d\u0435\u0442, \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0422\u043e\u0435\u0441\u0442\u044c \u0441\u043c\u044b\u0441\u043b \u0432 \u0442\u043e\u043c \u0447\u0442\u043e \u0435\u0441\u043b\u0438 \u044e\u0437\u0435\u0440 \u0434\u0430\u0451\u0442 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0445\u0435\u043d\u0434\u043e\u0444\u0444 \u0438\u043b\u0438 \u043f\u0440\u043e\u043c\u043f\u0442, \u0432 \u043a\u043e\u043d\u0446\u0435 \u044d\u0442\u043e \u043f\u0440\u0438\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043d\u0435\u0432\u0438\u0434\u0438\u043c\u043e \u043d\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0430\u0442\u0441\u044f \u0447\u0442\u043e Goal \u0430\u043a\u0442\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u043d \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 \u043f\u0440\u043e\u043c\u043f\u0442\u043e\u043c \u043a\u0430\u043a \u043e\u0431\u044b\u0447\u043d\u043e, \u044d\u0442\u043e \u0438\u0437\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u043e\u0442 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u0441\u043b\u0435\u0434\u043e\u043c \u0434\u0430\u0432\u0430\u0442\u044c goal cc all \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u044d\u0442\u043e \u0443\u0434\u043e\u0431\u043d\u043e \u0438 \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u043e."
    },
    "SRC-151:R030": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0417\u0434\u0435\u0441\u044c \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0443\u0436\u0435\u043d \u043f\u043e\u0438\u0441\u043a \u043f\u043e \u0444\u0443\u043d\u043a\u0446\u0438\u044f\u043c \u043e\u0447\u0435\u0432\u0438\u0434\u043d\u044b\u0439 \u0434\u043b\u044f \u044e\u0437\u0435\u0440\u0430 \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u0431\u044b\u0441\u0442\u0440\u043e \u043c\u043e\u0433 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043d\u0443\u0436\u043d\u0443\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443 \u043f\u043e \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c. ![](media/027_clipboard_20261003_224741_3b6dff3e.png)"
    },
    "SRC-151:R031": {
      "actionable": true,
      "class": "requirement",
      "text": "\u2022 \u0421\u043b\u043e\u0432\u0438\u043b \u0431\u0430\u0433 \u0433\u0434\u0435 \u044d\u0442\u0438 \u043a\u043d\u043e\u043f\u043a\u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u0438 \u043d\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044e\u0442 \u0432\u043e\u043e\u0431\u0449\u0435 \u043d\u0438\u043a\u0430\u043a\u0445 \u0443 Workers \u043f\u0430\u043d\u0435\u043b\u0438 ![](media/028_clipboard_20261003_224701_5c37956a.png)"

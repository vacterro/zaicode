# ZAICODE workspace root. The app source lives in zcode/ (its own git repo).
# This repo tracks only the workspace layer: launcher, docs, product contract.
# It also gives SAIPEN a git source identity, so `saipen status` hashes a few
# tracked files instead of walking ~70k build/smoke files on every call.
/zcode/
/.zaicode/
/.tools/
/.devhome/
*.log
/ZAICODE.exe
/ZAICODE.exe.old
# The other two root artifacts tools/launcher/build.cmd writes: STAGED before the
# swap, and the preview twin T-72 added on the success path.
/ZAICODE.exe.new
/ZAICODE-Preview.exe
# An installed ZAICODE (install/Install-ZAICODE.ps1) keeps its clones, private
# tools and venv next to the launcher; none of them belong to this repo.
/saipen/
/saimail/
/.venv/
/install/logs/
/install/install-report.json
/install/ZAICODE-Setup.exe
# The SAIPEN kernel a cloud executor fetches per .claude/skills/saipen/SKILL.md.
# It is pinned upstream, not authored here, so a stale local copy must never be
# committed.
/.claude/saipen-protocol/
